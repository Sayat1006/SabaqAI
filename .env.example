# Claude API кілті (https://console.anthropic.com). Бос болса — демо режим.
ANTHROPIC_API_KEY=
# Модель және ойлау деңгейі (міндетті емес)
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=medium
# Claude бас тартса, сұранысты басқа модельде қайта орындау (server-side fallback). Өшіру: off
CLAUDE_FALLBACKS=default

PORT=3000
# SQLite файлы
DB_PATH=./data/sabaq.db

# Алғашқы әкімші (тек дерекқор бос болғанда жасалады)
ADMIN_EMAIL=admin@sabaq.ai
ADMIN_PASSWORD=
ADMIN_NAME=Әкімші

# HTTPS артында іске қосқанда: 1
COOKIE_SECURE=0
# Reverse proxy (nginx т.б.) артында болса: 1
TRUST_PROXY=
